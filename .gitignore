__pycache__/
*.pyc
*.pyo
*.pyd

# Python build / packaging artifacts — safe to delete; regenerated by pip install -e .
*.egg-info/
*.egg
dist/
build/
.eggs/

# Test & type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.log
*.sqlite3
*.db
.DS_Store
.env
.vscode/
.idea/
# Ignore all docking outputs
docking/*.pdbqt
docking/config.py

# But keep these explicitly trackedresults/*.pdbqt
# Ignore everything under results/

# But allow nerds and geeks subfolders
!results/nerds/
!results/geeks/

# Then allow specific file types inside those
!results/nerds/*.pdbqt
!results/nerds/*.mp4
!results/nerds/*.gif
!results/geeks/*.pdbqt
!results/geeks/*.mp4
!results/geeks/*.gif

# Ignore everything under docking/
docking/*

# Ignore everything under docking/
# Allow Python scripts and key subfolders
!docking/*.py
!docking/AUTODOCK_GPU_DIR/
!docking/VINA_DIR/
!docking/MACRO_MOL_DIR/
!docking/VINA_DIR/**
!docking/MACRO_MOL_DIR/*.pdbqt

# AutoGrid output files
*.map
*.e.map
*.d.map
*.xyz
*.fld
*.gpf
*.glg

docking/MACRO_MOL_DIR/*.fld
docking/MACRO_MOL_DIR/*.gpf
docking/MACRO_MOL_DIR/*.glg

# Ignore AutoGrid4 binary (compiled locally)
docking/AUTODOCK_GPU_DIR/autogrid/autogrid4
docking/AUTODOCK_GPU_DIR/autogrid/.deps/*
docking/AUTODOCK_GPU_DIR/autogrid/ad4_shared/*
docking/AUTODOCK_GPU_DIR/autogrid/config.status
docking/AUTODOCK_GPU_DIR/autogrid/default_parameters.h
docking/AUTODOCK_GPU_DIR/autogrid/Makefile


!docking/autodock-gpu-compiler.sh
docking/AUTODOCK_GPU_DIR/autogrid/autom4te.cache/
docking/AUTODOCK_GPU_DIR/test_cuda
